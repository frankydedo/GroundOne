# Demo app (GroundOne Studio): build products and the generated Xcode project (regenerate with `xcodegen generate`)
Project/demo/GroundOne Studio/build/
Project/demo/GroundOne Studio/Packages/GroundOneKit/.build/
Project/demo/GroundOne Studio/Packages/GroundOneKit/.swiftpm/
Project/demo/GroundOne Studio/GroundOneStudio.xcodeproj/
*.profraw
# Demo outputs: only summaries are tracked (fixtures, indexes, audit logs and per-answer rows hold dataset text)
Project/outputs/demo/fixtures/
Project/outputs/demo/index/
Project/outputs/demo/audit/
Project/outputs/demo/logs/
Project/outputs/demo/casestudy/injected*.jsonl
Project/outputs/demo/casestudy/*/rows.jsonl
Project/outputs/demo/casestudy/*/audit.jsonl
# Demo outputs: the corpus text files are rebuilt by experiments/demo/scripts/build_corpus.py (questions.json and candidates.json are tracked)
Project/outputs/demo/corpus/*/

# App icon: only the icon in use (GroundOne-indigo) and its renders are tracked; the other palettes are design
# explorations, regenerated with Logo/IconComposer/build_icons.py OUT_DIR <palette>
Project/demo/GroundOne Studio/Logo/IconComposer/GroundOne-*.icon/
!Project/demo/GroundOne Studio/Logo/IconComposer/GroundOne-indigo.icon/
Project/demo/GroundOne Studio/Logo/IconComposer/renders/*
!Project/demo/GroundOne Studio/Logo/IconComposer/renders/indigo.png
!Project/demo/GroundOne Studio/Logo/IconComposer/renders/indigo-dark.png

