flowchart LR
 subgraph API["API Layer (FastAPI)"]
        Router["Endpoint: POST /v1/systemone"]
        Schema["Pydantic Request Validation"]
  end
 subgraph Inference["Optimized MLX Inference"]
        Prefill["KV Cache Manager (State Reuse)"]
        Forward["Single Forward Pass (O(1))"]
        Slice["Logit Slicer (Target Tokens A-Z)"]
        Softmax["Softmax Normalization"]
  end
 subgraph Engine["LogitExtractor Engine"]
    direction TB
        Formatter["Prompt Formatter (Multiple Choice)"]
        Tokenizer["Tokenizer"]
        Inference
  end
 subgraph LightningRoute["LightningRoute Service"]
    direction TB
        API
        Engine
  end
 subgraph Hardware["Apple Silicon (Metal GPU)"]
        Weights["LoRA Fine-tuned Weights (0.5B / 3B / 7B)"]
        VRAM["Persistent KV Cache"]
  end
    Client("Client / Orchestrator") -- "1. Query + Tool List" --> Router
    Router --> Schema
    Schema --> Formatter
    Formatter -- "2. Formatted Prompt" --> Tokenizer
    Tokenizer -- "3. Token IDs" --> Prefill
    Prefill -- "4. Cached Context" --> Forward
    Forward -- "5. Raw Vocab Logits" --> Slice
    Slice -- "6. Target Token Logits" --> Softmax
    Forward -.-> Weights
    Prefill -.-> VRAM
    Softmax -- "7. Routing Decision + Confidence" --> Client

    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px
    classDef highlight fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    classDef core fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px