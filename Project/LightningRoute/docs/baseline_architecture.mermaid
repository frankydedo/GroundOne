flowchart TD
    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px
    classDef highlight fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    classDef bottleneck fill:#ffebee,stroke:#c62828,stroke-width:2px

    Client("Client / Orchestrator")
    
    subgraph Server ["Generative Inference Server (e.g., LM Studio)"]
        direction TB
        Prompt["Prompt Constructor"]
        Tokenizer["Tokenizer"]
        
        subgraph LLM ["Generative Language Model (e.g., Qwen 7B)"]
            Prefill["KV Cache Prefill Phase\n(Time to First Token: 500-2000ms)"]
            
            subgraph Loop ["Autoregressive Generation (Latency Bottleneck)"]
                direction TB
                Forward["Model Forward Pass"]
                Sample["Token Sampling (Temperature/Top-P)"]
                Forward --> Sample
                Sample -. "Next Token" .-> Forward
            end
        end
        
        Parser["JSON Parser / Output Validator"]
    end

    Client -- "1. Function Calling Request" --> Prompt
    Prompt -- "2. System Prompt + JSON Schema" --> Tokenizer
    Tokenizer -- "3. Input Tokens" --> Prefill
    Prefill -- "4. Initial Hidden States" --> Loop
    Loop -- "5. Raw Text Output (JSON String)" --> Parser
    Parser -- "6. Parsed Tool Call / Error" --> Client

    class Loop bottleneck
    class LLM highlight
